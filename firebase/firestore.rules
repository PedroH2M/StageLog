rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo global de insígnias (somente leitura para usuários autenticados)
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Dados isolados por usuário (Perfil, Shows Marcados, Insígnias e Shows Customizados)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /attended_shows/{showId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /user_badges/{badgeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /custom_shows/{showId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
