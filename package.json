{
  "name": "stagelog-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "StageLog - Passaporte de Shows, Setlists e Insígnias Gamificadas",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1 -Target apk",
    "aab": "powershell -ExecutionPolicy Bypass -File ./scripts/build-apk.ps1 -Target aab"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "canvas-confetti": "^1.9.3",
    "firebase": "^13.2.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
